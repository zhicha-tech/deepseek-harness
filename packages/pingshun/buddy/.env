# 平顺 Buddy 部署环境变量（复制为 .env 并填入实际值；.env 不提交到仓库）
# 放置位置：包根目录（packages/pingshun/buddy/.env，或安装后的 node_modules/@pingshun/buddy/.env）
# 优先级：Settings 界面配置 > 系统环境变量 > 本文件

# 模型服务（OpenAI 兼容端点）
PINGSHUN_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
PINGSHUN_LLM_API_KEY=14592bac79ae4139bcb1dc59e79d80f4.TOSEqScMXisYShxJ
# 可选：默认模型 id（缺省取模型列表第一个）
# PINGSHUN_LLM_DEFAULT_MODEL=pingshun-glm-large

# OCR 服务（可选，也可在 Settings → OCR 中配置）
# PINGSHUN_PADDLE_OCR_TOKEN=
# PINGSHUN_MINERU_OCR_TOKEN=

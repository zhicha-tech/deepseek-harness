{
  "name": "@deepseek-ai/dsh-pingshun-buddy",
  "description": "\u5e73\u987a Buddy\uff1a\u516d\u4e2a\u4f01\u4e1a\u529e\u516c\u6570\u5b57\u540c\u4e8b Agent Preset\uff08\u529e\u516c\u3001\u515a\u5efa\u3001\u5ba3\u4f20\u3001\u8d22\u52a1\u3001\u5e02\u573a\u62db\u6295\u6807\u3001\u5de5\u7a0b\u73b0\u573a\uff09\u4e0e DS-Bot \u98ce\u683c Buddy Web UI\uff0c\u4f5c\u4e3a\u53ef\u5b89\u88c5\u7684 dsh Profile Bundle\u3002",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./runtime": {
      "types": "./lib/types/host/runtime.d.ts",
      "default": "./lib/host/runtime.js"
    },
    "./ocr-tools": {
      "types": "./lib/types/host/ocr-tools.d.ts",
      "default": "./lib/host/ocr-tools.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    ".env",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "lib/*.js",
    "lib/host/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.3",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "build": "pnpm run typecheck && pnpm run bundle",
    "package:desktop:win": "pnpm --dir ../../.. --filter @deepseek-ai/dsh-desktop run package:win:x64:unsigned",
    "package:desktop:mac": "pnpm --dir ../../.. --filter @deepseek-ai/dsh-desktop run package:mac:arm64:unsigned"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
